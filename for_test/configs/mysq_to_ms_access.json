{
    "name": "MySQL to MS Access",
    "source": {
      "type": "mysql",
      "connection_params": {
        "host": "MYSQL_HOST",
        "port": 3306,
        "user": "MYSQL_USER",
        "password": "MYSQL_PASSWORD",
        "database": "MYSQL_DB1"
      }
    },
    "destination": {
      "type": "access",
      "connection_params": {
        "path": "test_db3.accdb"
      }
    },
    "jobs": [
      {
        "source": {
          "table": "table1"
        },
        "destination": {
          "table": "table1_access"
        },
        "mode": "replace"
      }
    ]
  }